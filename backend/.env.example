
# Flow Football Analytics — backend configuration template
#
# Copy this file to backend/.env for local development.
# Add your real API credentials locally. Never commit backend/.env to Git.
# Environment variables configured by the hosting provider take precedence.

# football-data.org API token
FOOTBALL_DATA_API_TOKEN=

# API-Football API key
API_FOOTBALL_KEY=

# Frontend origins allowed to make cross-origin browser requests.
# Separate multiple origins with commas. Do not include trailing slashes.
#
# Local Vite development:
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Rate-limit time window in seconds.
RATE_LIMIT_WINDOW_SECONDS=60

# General fallback limit, requests per client IP per window.
RATE_LIMIT_REQUESTS_PER_MINUTE=180

# Endpoint-specific limits, requests per client IP per window.
RATE_LIMIT_FOOTBALL_DATA_REQUESTS=60
RATE_LIMIT_API_FOOTBALL_REQUESTS=60
RATE_LIMIT_FPL_REQUESTS=60
RATE_LIMIT_LEAGUE_DATA_REQUESTS=60
RATE_LIMIT_PLAYER_DETAILS_REQUESTS=60
